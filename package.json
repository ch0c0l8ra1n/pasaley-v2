{
  "name": "pasaley-v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite -c vite.chartApp.config.ts",
    "playground": "vite -c vite.playground.config.ts",
    "playground:save": "node playground/save-daraz-page.mjs",
    "build": "vite build -c vite.interceptor.config.ts && tsc -b && vite build -c vite.chartApp.config.ts",
    "build:staging": "vite build -c vite.interceptor.config.ts --mode staging && tsc -b && vite build -c vite.chartApp.config.ts --mode staging",
    "build:dev": "vite build -c vite.interceptor.config.ts --mode development && tsc -b && vite build -c vite.chartApp.config.ts --mode development",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir dist",
    "record": "node tests/record.mjs",
    "test:replica": "npm run build && node --test tests/replica.test.mjs",
    "test:live": "npm run build && node --test tests/live.test.mjs",
    "zip": "rm -f pasaley.zip && cd dist && zip -qr ../pasaley.zip .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "highcharts": "^12.0.2",
    "highcharts-react-official": "^3.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-social-icons": "^6.18.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "web-ext": "^10.8.0"
  }
}
